# Copy to .env.local and add a server-side OpenAI API key.
OPENAI_API_KEY=

# Server-only password for entering the oracle.
ORACLE_PASSWORD=""

# Generate a random signing secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Separate from ORACLE_PASSWORD; changing it signs everyone out.
ORACLE_SESSION_SECRET=

# Durable Redis REST credentials. Vercel's Upstash integration provides these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
