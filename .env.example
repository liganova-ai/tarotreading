# Copy to .env.local and add a server-side OpenAI API key.
OPENAI_API_KEY=

# Gate app registration credentials. Never use NEXT_PUBLIC_ for these.
GATE_URL=https://credential-gate-jirby.vercel.app
GATE_APP_KEY=

# Generate a random signing secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out and invalidates encrypted workflow records.
ORACLE_SESSION_SECRET=

# Durable Redis REST credentials. Vercel's Upstash integration provides these.
KV_REST_API_URL=
KV_REST_API_TOKEN=
